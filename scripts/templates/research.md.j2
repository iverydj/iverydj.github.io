<ul class="research-intro">
{% for s in research.intro.statements %}
<li>{{ s | safe }}</li>
{% endfor %}
</ul>

{% for t in research.themes %}
::: {.research-theme}

## {{ loop.index }}. {{ t.title }}

<p class="rs-question">{{ t.question }}</p>

{% for item in t['items'] %}
- {{ item.text | safe }} <span class="rs-meta"><span class="rs-status rs-status-{{ item.status | lower | replace(' ', '-') }}">{{ item.status }}</span>{% if item.refs is defined %} <span class="rs-refs">{{ item.refs | cite(false) }}</span>{% endif %}</span>
{% endfor %}

:::

{% endfor %}
