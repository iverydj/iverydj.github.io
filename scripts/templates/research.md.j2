<ul class="research-intro">
{% for s in research.intro.statements %}
<li>{{ s | safe }}</li>
{% endfor %}
</ul>

{% for t in research.themes %}
::: {.research-theme}

## {{ loop.index }}. {{ t.title }}

<p class="rs-question">{{ t.question }}</p>

{% for item in t['items'] %}
- {{ item.text | safe }}{% if item.refs is defined %} <span class="rs-meta"><span class="rs-refs">{{ item.refs | cite }}</span></span>{% endif +%}
{% endfor %}

:::

{% endfor %}
