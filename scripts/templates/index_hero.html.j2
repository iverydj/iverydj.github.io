```{=html}
<p class="last-update">Last updated: {{ profile.updated }}</p>
<p class="hero-name">{{ profile.name_first }} {{ profile.name_last }}</p>
<p class="hero-position">{{ profile.position }}{% if education[0].expected is defined %} <span class="hero-expected">(expected {{ education[0].expected }})</span>{% endif %}</p>
<p class="hero-dept">{{ profile.department }}, {{ profile.school }}</p>

<div class="hero-divider"></div>

<p class="hero-lab">{{ profile.lab }}</p>
<p class="hero-lab-dept">{{ profile.lab_department }}, Republic of Korea</p>
<p class="hero-advisor">(Advisor: {{ profile.advisor }})</p>

<div class="hero-divider"></div>

<dl class="hero-contact">
  <div class="contact-row">
    <dt class="contact-label">Email</dt>
    <dd>{% for m in profile.emails %}<a href="mailto:{{ m }}">{{ m }}</a>{% if not loop.last %} / {% endif %}{% endfor %}</dd>
  </div>
  <div class="contact-row">
    <dt class="contact-label">Google Scholar</dt>
    <dd><a href="{{ profile.scholar }}">View profile</a></dd>
  </div>
  <div class="contact-row">
    <dt class="contact-label">GitHub</dt>
    <dd><a href="{{ profile.github }}">{{ profile.github | replace('https://', '') }}</a></dd>
  </div>
</dl>
```
