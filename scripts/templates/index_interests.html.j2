```{=html}
<p class="research-summary">{{ research.summary | safe }}</p>
<div class="interest-groups">
{% for t in research.themes %}
  <section class="interest-group">
    <h3 class="interest-label">{{ t.title }}</h3>
    <div class="research-keywords">
{% for k in t.keywords %}
      <span>{{ k }}</span>
{% endfor %}
    </div>
  </section>
{% endfor %}
</div>
```
